# =========================================================
#  GH Roleplay — chaves de API
#  Copie este arquivo para ".env" (na mesma pasta) e preencha.
#  Depois reinicie:  npm start
#  Linhas com # no começo são comentários — descomente a que for usar.
#  O que já estiver definido no ambiente do computador vence o .env.
# =========================================================

# --- Pix automático (Mercado Pago) ---
# Onde arrumar: mercadopago.com → Suas integrações → Credenciais de
# produção → Access token (o de teste só serve para testes).
#MP_ACCESS_TOKEN=SEU_TOKEN_DE_PRODUCAO_AQUI

# --- Login com Discord (opcional) ---
# Onde arrumar: discord.com/developers → New Application → OAuth2.
# Em Redirects do OAuth2 adicione: https://SEUSITE.com/api/auth/discord/callback
#DISCORD_CLIENT_ID=ID_DO_SEU_APP
#DISCORD_CLIENT_SECRET=SECRET_DO_SEU_APP
#GHRP_ORIGIN=https://loja.seudominio.com

# --- Entrega automática no FiveM (obrigatória p/ a fila) ---
# A MESMA chave vai no server.cfg do FiveM:
#   set gh_loja_chave "uma-chave-secreta-bem-longa"
# Ver resources/gh-loja/README.md para o passo a passo.
#GHRP_SERVER_KEY=uma-chave-secreta-bem-longa

# --- Extras (raramente precisa mexer) ---
# Pasta do banco de dados (padrão: apps/api/data)
#GHRP_DATA=c:\caminho\da\pasta
# Porta da loja (padrão: 8123)
#PORT=8123

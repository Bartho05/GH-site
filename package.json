{
  "name": "gh-roleplay",
  "private": true,
  "version": "1.0.0",
  "description": "Monorepo da loja GH Roleplay: apps/web (site + painel) e apps/api (backend Node puro).",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspace apps/web",
    "start": "node scripts/start.mjs",
    "dev": "node scripts/dev.mjs",
    "test": "npm test --workspaces --if-present"
  },
  "engines": {
    "node": ">=22"
  }
}
